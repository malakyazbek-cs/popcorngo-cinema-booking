<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="250dp"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:background="#B4B4B4"
            android:layout_marginTop="20dp"
            android:contentDescription="Movie Poster"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie Title Goes Here"
            android:textSize="25sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie synopsis here..."
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="142 MINUTES"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_genre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Action / Adventure / Sci-Fi"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_trailer_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://youtube.com/..."
            android:textSize="16sp"
            android:textColor="#0000FF"
            android:layout_marginBottom="10dp"
            android:padding="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a Showtime"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShowtimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
